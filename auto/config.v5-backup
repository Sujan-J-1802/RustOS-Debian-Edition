#!/bin/sh
set -eu

lb config noauto \
  --mode debian \
  --distribution trixie \
  --architectures amd64 \
  --binary-images iso-hybrid \
  --archive-areas "main contrib non-free non-free-firmware" \
  --apt-recommends true \
  --firmware-chroot true \
  --firmware-binary true \
  --debian-installer none \
  --image-name rustos-debian \
  --iso-application "RustOS Debian Edition" \
  --iso-volume "RUSTOS_DEBIAN"
