#!/usr/bin/env python3

import csv
import re
import subprocess
from datetime import datetime, timezone
from pathlib import Path

OUTPUT = Path("/var/log/rustos-boot-benchmarks.csv")
BOOT_ID = Path("/proc/sys/kernel/random/boot_id").read_text().strip()

# Avoid recording the same boot twice.
if OUTPUT.exists():
    with OUTPUT.open(newline="") as f:
        if any(row.get("boot_id") == BOOT_ID
               for row in csv.DictReader(f)):
            print("This boot has already been recorded.")
            raise SystemExit(0)

result = subprocess.run(
    ["systemd-analyze", "time"],
    capture_output=True,
    text=True,
    check=True,
)

text = result.stdout + result.stderr

kernel = re.search(
    r"([\d.]+)s \(kernel\)", text
)
userspace = re.search(
    r"([\d.]+)s \(userspace\)", text
)

if not kernel or not userspace:
    raise SystemExit("ERROR: Cannot parse boot timing.")

k = float(kernel.group(1))
u = float(userspace.group(1))

OUTPUT.parent.mkdir(parents=True, exist_ok=True)
new_file = not OUTPUT.exists()

with OUTPUT.open("a", newline="") as f:
    writer = csv.writer(f)

    if new_file:
        writer.writerow([
            "boot_id",
            "timestamp",
            "kernel_seconds",
            "userspace_seconds",
            "total_seconds",
        ])

    writer.writerow([
        BOOT_ID,
        datetime.now(timezone.utc).isoformat(),
        f"{k:.3f}",
        f"{u:.3f}",
        f"{k + u:.3f}",
    ])

print(f"Recorded boot time: {k + u:.3f}s")
